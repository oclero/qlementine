{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "macos",
      "displayName": "macOS",
      "description": "Ninja project for macOS",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/_build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "/opt/homebrew/opt/qt/lib/cmake/Qt6",
        "QLEMENTINE_SANDBOX": true,
        "QLEMENTINE_SHOWCASE": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows",
      "description": "Visual Studio 2026 x64 project for Windows",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": "host=x64",
      "binaryDir": "${sourceDir}/_build",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "C:/Qt/6.10.3/msvc2022_64",
        "QLEMENTINE_SANDBOX": true,
        "QLEMENTINE_SHOWCASE": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-ci",
      "displayName": "Windows CI",
      "description": "Ninja project for Windows CI",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/_build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "QLEMENTINE_SANDBOX": true,
        "QLEMENTINE_SHOWCASE": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux",
      "description": "Ninja project for Linux",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/_build",
      "cacheVariables": {
        "QLEMENTINE_SANDBOX": true,
        "QLEMENTINE_SHOWCASE": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-shared",
      "displayName": "Linux (Shared Library)",
      "description": "Makefile for Linux with shared library",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/_build_shared",
      "cacheVariables": {
        "BUILD_SHARED_LIBS": true,
        "QLEMENTINE_SANDBOX": true,
        "QLEMENTINE_SHOWCASE": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "macos",
      "displayName": "macOS",
      "configurePreset": "macos",
      "description": "Build with Ninja for macOS",
      "targets": ["qlementine"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-sandbox",
      "displayName": "Sandbox for macOS",
      "configurePreset": "macos",
      "description": "Sandbox - Build with Ninja for macOS",
      "targets": ["sandbox"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-showcase",
      "displayName": "Showcase for macOS",
      "configurePreset": "macos",
      "description": "Showcase - Build with Ninja for macOS",
      "targets": ["showcase"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows",
      "configurePreset": "windows",
      "description": "Build with Visual Studio for Windows",
      "targets": ["qlementine"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-sandbox",
      "displayName": "Sandbox for Windows",
      "configurePreset": "windows",
      "description": "Sandbox - Build with Visual Studio for Windows",
      "targets": ["sandbox"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-showcase",
      "displayName": "Showcase for Windows",
      "configurePreset": "windows",
      "description": "Showcase - Build with Visual Studio for Windows",
      "targets": ["showcase"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-ci",
      "displayName": "Windows CI",
      "configurePreset": "windows-ci",
      "description": "Build with Ninja for Windows CI",
      "targets": ["qlementine"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-ci-sandbox",
      "displayName": "Sandbox for Windows CI",
      "configurePreset": "windows-ci",
      "description": "Sandbox - Build with Ninja for Windows CI",
      "targets": ["sandbox"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-ci-showcase",
      "displayName": "Showcase for Windows CI",
      "configurePreset": "windows-ci",
      "description": "Showcase - Build with Ninja for Windows CI",
      "targets": ["showcase"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux",
      "configurePreset": "linux",
      "description": "Build for Linux",
      "targets": ["qlementine"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-sandbox",
      "displayName": "Sandbox for Linux",
      "configurePreset": "linux",
      "description": "Sandbox - Build for Linux",
      "targets": ["sandbox"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-showcase",
      "displayName": "Showcase for Linux",
      "configurePreset": "linux",
      "description": "Showcase - Build for Linux",
      "targets": ["showcase"],
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ]
}
